<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvNum"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/gold"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="64dp"
        android:layout_height="80dp"
        android:background="@color/tanne_dunkel"
        android:contentDescription="Vorschau"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:maxLines="3"
        android:paddingStart="10dp"
        android:textColor="@color/text_gedimmt"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btnUp"
        style="@style/ItemAction"
        android:contentDescription="Nach oben"
        android:text="↑" />

    <TextView
        android:id="@+id/btnDown"
        style="@style/ItemAction"
        android:contentDescription="Nach unten"
        android:text="↓" />

    <TextView
        android:id="@+id/btnRotate"
        style="@style/ItemAction"
        android:contentDescription="Drehen"
        android:text="⟳" />

    <TextView
        android:id="@+id/btnDelete"
        style="@style/ItemAction"
        android:contentDescription="Entfernen"
        android:text="✕"
        android:textColor="#E8A59B" />
</LinearLayout>
