<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Zurück"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/gold"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/gold"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/btnPick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_btn_gold"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="📂"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PDF auswählen"
                        android:textColor="@color/auf_gold"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tippen, um eine PDF zu wählen"
                        android:textColor="@color/auf_gold_sub"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/auf_gold"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/secSplit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_tile_gruen"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="So aufteilen"
                    android:textColor="@color/gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgSplit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbEach"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/gold"
                        android:checked="true"
                        android:text="Jede Seite einzeln"
                        android:textColor="@color/text_hell" />

                    <RadioButton
                        android:id="@+id/rbRanges"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:buttonTint="@color/gold"
                        android:text="Nach Bereichen"
                        android:textColor="@color/text_hell" />
                </RadioGroup>

                <EditText
                    android:id="@+id/etRanges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/gold"
                    android:hint="z. B. 1-3, 4, 5-10"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_hell"
                    android:textColorHint="#C9D8CE"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Bei „Nach Bereichen“ wird jeder Bereich eine eigene PDF. Mit einem einzigen Bereich (z. B. 2-5) holst du einfach diese Seiten heraus."
                    android:textColor="@color/text_gedimmt"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/secCompress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_tile_gruen"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="Stärke"
                    android:textColor="@color/gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/gold"
                        android:text="Leicht"
                        android:textColor="@color/text_hell" />

                    <RadioButton
                        android:id="@+id/rbMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:buttonTint="@color/gold"
                        android:checked="true"
                        android:text="Mittel"
                        android:textColor="@color/text_hell" />

                    <RadioButton
                        android:id="@+id/rbStrong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:buttonTint="@color/gold"
                        android:text="Stark"
                        android:textColor="@color/text_hell" />
                </RadioGroup>

                <CheckBox
                    android:id="@+id/cbRaster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:buttonTint="@color/gold"
                    android:text="Seiten komplett als Bild (kleinste Datei)"
                    android:textColor="@color/text_hell"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Normal werden nur die Bilder in der PDF verkleinert, Text bleibt scharf und markierbar. Als Bild wird alles zu Fotos der Seiten: am kleinsten, aber Text ist danach nicht mehr auswähl- oder durchsuchbar."
                    android:textColor="@color/text_gedimmt"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/secImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_tile_gruen"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="Format"
                    android:textColor="@color/gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgFormat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbJpg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/gold"
                        android:checked="true"
                        android:text="JPG"
                        android:textColor="@color/text_hell" />

                    <RadioButton
                        android:id="@+id/rbPng"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:buttonTint="@color/gold"
                        android:text="PNG"
                        android:textColor="@color/text_hell" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Auflösung"
                    android:textColor="@color/gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgRes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbResLow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/gold"
                        android:text="Klein"
                        android:textColor="@color/text_hell" />

                    <RadioButton
                        android:id="@+id/rbResMid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:buttonTint="@color/gold"
                        android:checked="true"
                        android:text="Normal"
                        android:textColor="@color/text_hell" />

                    <RadioButton
                        android:id="@+id/rbResHigh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:buttonTint="@color/gold"
                        android:text="Hoch"
                        android:textColor="@color/text_hell" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Seiten"
                    android:textColor="@color/gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etPages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/gold"
                    android:hint="Leer = alle, z. B. 1-3, 5"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_hell"
                    android:textColorHint="#C9D8CE" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Klein ≈ 100 dpi, Normal ≈ 150 dpi, Hoch ≈ 300 dpi (gut zum Drucken)."
                    android:textColor="@color/text_gedimmt"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/secStamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_tile_gruen"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <CheckBox
                    android:id="@+id/cbNumbers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/gold"
                    android:checked="true"
                    android:text="Seitenzahlen einfügen"
                    android:textColor="@color/text_hell"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgNumPos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbPosCenter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/gold"
                        android:checked="true"
                        android:text="Unten Mitte"
                        android:textColor="@color/text_hell" />

                    <RadioButton
                        android:id="@+id/rbPosRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/gold"
                        android:text="Unten rechts"
                        android:textColor="@color/text_hell" />

                    <RadioButton
                        android:id="@+id/rbPosTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/gold"
                        android:text="Oben rechts"
                        android:textColor="@color/text_hell" />
                </RadioGroup>

                <CheckBox
                    android:id="@+id/cbNumTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/gold"
                    android:text="Als „Seite 3 von 20“ schreiben"
                    android:textColor="@color/text_hell"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Wasserzeichen (diagonal, grau, durchscheinend)"
                    android:textColor="@color/gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etWatermark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/gold"
                    android:hint="z. B. ENTWURF oder VERTRAULICH (leer = keins)"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="40"
                    android:maxLines="1"
                    android:textColor="@color/text_hell"
                    android:textColorHint="#C9D8CE" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/secProtect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_tile_gruen"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tvWasEncrypted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Diese PDF war mit einem Passwort geschützt. Ohne neues Passwort wird sie ungeschützt gespeichert."
                    android:textColor="@color/gold"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <CheckBox
                    android:id="@+id/cbMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:buttonTint="@color/gold"
                    android:checked="true"
                    android:text="Metadaten entfernen (Autor, Programm, Titel, Datum)"
                    android:textColor="@color/text_hell"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:buttonTint="@color/gold"
                    android:text="Passwort zum Öffnen festlegen"
                    android:textColor="@color/text_hell"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/boxPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etPw1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/gold"
                        android:hint="Passwort"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/text_hell"
                        android:textColorHint="#C9D8CE" />

                    <EditText
                        android:id="@+id/etPw2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/gold"
                        android:hint="Passwort wiederholen"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/text_hell"
                        android:textColorHint="#C9D8CE" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Verschlüsselung mit AES-256. Wer das Passwort kennt, darf die PDF auch drucken und bearbeiten."
                    android:textColor="@color/text_gedimmt"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:textColor="@color/text_hell"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/btnRun"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_btn_gold"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="⚙️"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/tvAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Los"
                android:textColor="@color/auf_gold"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActionSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/auf_gold_sub"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/auf_gold"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:progressTint="@color/gold"
        android:indeterminateTint="@color/gold"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ad"
        android:minHeight="60dp" />
</LinearLayout>
