<?xml version="1.0" encoding="utf-8"?>
<!-- Glänzende 3D-Kachel: Schatten, Goldrahmen, gewölbte Fläche, Glanzlicht oben, helle Kante unten. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#66FFFFFF">
    <item>
        <layer-list>
            <item android:left="3dp" android:top="7dp">
                <shape android:shape="rectangle">
                    <solid android:color="#99000000" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:bottom="6dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#FFF3BD" android:centerColor="#D9A93A" android:endColor="#4A2E10" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:bottom="9dp" android:left="3dp" android:right="6dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#AA7D5D" android:centerColor="#723E1B" android:endColor="#381F0F" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
            <item android:bottom="9dp" android:left="3dp" android:right="6dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#33FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#33000000" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
            <item android:height="34dp" android:left="9dp" android:right="12dp" android:top="6dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#80FFFFFF" android:endColor="#05FFFFFF" />
                    <corners android:topLeftRadius="12dp" android:topRightRadius="12dp" android:bottomLeftRadius="26dp" android:bottomRightRadius="26dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
