<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#66FFFFFF">
    <item>
        <layer-list>
            <item android:left="3dp" android:top="7dp">
                <shape android:shape="rectangle">
                    <solid android:color="#99000000" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:bottom="6dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FFF0A8" android:centerColor="#EBC04A" android:endColor="#9A7020" />
                    <stroke android:width="2.5dp" android:color="#2A1B08" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:bottom="6dp" android:right="3dp" android:left="0dp" android:top="0dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#33FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#33000000" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:height="26dp" android:left="10dp" android:right="13dp" android:top="6dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#99FFFFFF" android:endColor="#08FFFFFF" />
                    <corners android:topLeftRadius="14dp" android:topRightRadius="14dp" android:bottomLeftRadius="22dp" android:bottomRightRadius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
